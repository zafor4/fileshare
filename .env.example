# Production compose (docker-compose.prod.yml)
# Copy to .env on the VPS and set strong secrets before first deploy.

POSTGRES_USER=fileshare
POSTGRES_PASSWORD=change-me-use-a-long-random-password
POSTGRES_DB=fileshare

JWT_SECRET=change-me-use-a-long-random-jwt-secret
JWT_EXPIRES_IN=7d
# 64 hex characters (32 bytes) — required for credential encryption at rest
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

CORS_ORIGIN=https://files.zaforiq.me
NEXT_PUBLIC_API_URL=https://files.zaforiq.me/api